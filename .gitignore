# Repository-wide ignores (each module may add its own .gitignore)

# Secrets
.env
.env.*

# Dependencies and build output
node_modules/
dist/
.venv/
venv/
__pycache__/
*.pyc

# Local archives
*.zip

# Client data (confidential, stays on this PC)
Client Module/data/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Claude Code local tooling
.claude/

# Local API keys - never commit
Api Secrets/

# Client workbook and signed agreements (confidential, stay on this PC)
Resources/
Database Module/Banking Base/data/
Database Module/Banking Base/private/
