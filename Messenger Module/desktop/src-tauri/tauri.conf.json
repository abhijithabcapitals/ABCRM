{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AB Capital Messenger",
  "version": "0.1.0",
  "identifier": "ae.abcapital.messenger",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build:desktop",
      "cwd": "../../../Main Module"
    },
    "beforeDevCommand": {
      "script": "npm run dev:desktop",
      "cwd": "../../../Main Module"
    },
    "devUrl": "http://localhost:5192/desktop.html",
    "frontendDist": "../../../Main Module/dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AB Capital Messenger",
        "url": "desktop.html",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://pnnakrhfzyxudjaghoxx.supabase.co wss://pnnakrhfzyxudjaghoxx.supabase.co https://*.r2.cloudflarestorage.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "abmessenger"
        ]
      }
    }
  }
}
